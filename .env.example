# Database — SQLite by default (zero-config, single file). For PostgreSQL instead, use:
#   DATABASE_URL=postgresql://user:password@localhost:5432/face_id   (needs psycopg2-binary)
DATABASE_URL=sqlite:///./face_id.db

# Biometric secret key (HMAC) — change this and all templates become invalid
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BIOMETRIC_SECRET_KEY=change_me_generate_a_random_hex_key

# Camera sources (comma-separated: index or RTSP URL)
# Examples: "0", "0,1", "rtsp://user:pass@192.168.1.100/stream"
CAMERA_SOURCES=0

# Recognition threshold (cosine distance, lower = stricter)
# InsightFace ArcFace recommended: 0.5
MATCH_THRESHOLD=0.5

# Detector confidence (SCRFD): higher = fewer false detections but more missed/
# flickering faces (false negatives). 0.5 is the InsightFace default.
DET_THRESHOLD=0.5
# Discard faces shorter than this many pixels (filters mirror reflections and far
# faces). Raise if reflections still trigger alerts; lower if real faces are missed.
MIN_FACE_PX=80

# GPU acceleration — True uses NVIDIA CUDA if available, falls back to CPU
USE_GPU=true

# Web UI password (HTTP Basic Auth, any username). REQUIRED if you expose the
# web UI beyond localhost (python main.py --web --host 0.0.0.0)
WEB_PASSWORD=

# Retention period in days (GDPR data minimization)
DATA_RETENTION_DAYS=365

# Base directory for persistent artifacts (DB, validation, benchmarks, logs).
# In Docker this is the /data volume.
DATA_DIR=data

# Pipeline timing instrumentation (FPS / per-stage latency for the dashboard)
METRICS_ENABLED=true

# ── Validation / test mode (open-set 1:N accuracy experiments) ─────────────────
# Off by default; enabled per-run with `python main.py --validation [NOME]` or from the
# /validation web page (zero overhead when off). Artifacts (PROTOCOL.md, session.json,
# detections.jsonl, labels.jsonl, metrics.json, det_curve.csv, cmc.csv, video/cam_<id>.mp4)
# are written under DATA_DIR/validation/<session_id>/ — OUTSIDE the biometric DB and never
# committed to git. The footage is sensitive: delete it after analysis with
# `python scripts/clear_validation.py`.
#
# VALIDATION_DIR overrides where the validation volume lives (…/validation under it) — set it
# to an already-mounted external disk to keep the bulky video off the system drive. Leave empty
# to use DATA_DIR/validation. The web Start wizard can also pick a destination per session.
# IMPORTANT: only the append-only validation artifacts go here. The SQLite DB ALWAYS stays on
# internal storage (FAT32/exFAT/NTFS have file-locking issues) — never point DATABASE_URL at a
# removable disk. The annotated video is recorded in segments so FAT32's 4 GB limit is never hit.
VALIDATION_DIR=

# VALIDATION_RECORD_VIDEO — default for whether a validation session records annotated video.
# false (default) = NO video, NO images on disk: ground truth is established live (declared
# subject for crossings, declared seating map for the common session, + optional live
# click-to-assign). This restores the "no images on disk" GDPR posture and drops the FAT32
# video constraints; only append-only text logs are written. Set true to keep the legacy
# video-recording mode as a fallback. The /validation web page has a per-session toggle that
# overrides this default. Metrics (FPIR/FNIR/DET/EER) are identical in both modes.
VALIDATION_RECORD_VIDEO=false

# Seconds between saved map-position points, per person per camera
POSITION_LOG_INTERVAL=1.0

# ── Telegram bot (unknown-subject alerts + enrollment by message) ──────────────
# Text-only alerts (no images). Create a bot with @BotFather, get the numeric
# chat id from @userinfobot. Leave disabled if unused.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seconds between alerts per camera, and seconds of CONTINUOUS "unknown" required
# before alerting (a brief head turn under this won't trigger a notification).
UNKNOWN_ALERT_COOLDOWN=10.0
UNKNOWN_ALERT_MIN_DURATION=1.0
# No unknown alerts in the first N seconds (camera exposure warm-up at startup)
UNKNOWN_ALERT_WARMUP=15.0

# Log level
LOG_LEVEL=INFO

# Performance profile (standard | optimized-tx2) — switchable at runtime from the dashboard.
PERFORMANCE_PROFILE=standard
# ============================================================================================
# !!! OPT_MODEL_PACK — LEGGERE PRIMA DI CAMBIARE !!!
# buffalo_s e' il pack del profilo Optimized per il confronto Fase-1/Fase-2 del paper.
# Se lo imposti a buffalo_l, ENTRAMBI i profili usano lo stesso recognizer e il confronto
# tra profili NON misura piu' nulla (incidente di laboratorio gia' avvenuto!). Il semaforo
# nella dashboard mostra il pack REALMENTE caricato: verde = ok, arancio = mismatch.
# buffalo_s = spazio embedding DIVERSO da buffalo_l -> registrazione volti per-profilo.
# ============================================================================================
OPT_MODEL_PACK=buffalo_s
# Optimized profile: re-embed a tracked face every N processed frames (0 = never). The IoU tracker
# caches the embedding to save the ArcFace pass; without a periodic re-embed the match distance/
# confidence shown on the video overlay stays FROZEN. 10 ≈ refresh ~1-2×/s keeping most of the
# tracker speed-up. Lower = fresher distance but more compute; 0 = old behaviour (static distance).
OPT_REEMBED_EVERY=10
# If onnxruntime r32.7 doesn't free native GPU memory on a profile switch (RAM climbs across
# switches), set true: a switch then cleanly restarts the process (Docker restart) on the new
# profile — ~seconds feed gap, zero leak.
PROFILE_SWITCH_RESTART=false
