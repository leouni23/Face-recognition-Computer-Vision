# syntax=docker/dockerfile:1
#
# Face ID - Jetson TX2 (ARM64 / L4T r32.7 / JetPack 4.6 / CUDA 10.2 / Python 3.6).
# BUILD AND RUN ON THE DEVICE.
#
# Single image, profile selectable at runtime (Standard / Optimized-TX2). The base
# dustynv/onnxruntime:r32.7.1 already ships, compiled for L4T r32.7: CUDA + cuDNN +
# onnxruntime-gpu + numpy + OpenCV. BUT that base OpenCV (4.12) is built WITHOUT the FFMPEG and
# GStreamer backends, so cv2.VideoCapture cannot open RTSP/RTMP/HTTP streams (verified:
# `FFMPEG: NO`, `GStreamer: NO`). We therefore REBUILD OpenCV from source here with both backends
# ON, replacing the base cv2 (see the "OpenCV from source" stage). USB cameras worked before via
# V4L2; RTSP now works via the FFMPEG (software-decode) backend. Models + TensorRT engines are NOT
# baked in: they are downloaded / built on first run onto the external disk mounted at /data.
#
#   Build (on the TX2, FIRST build is long ~1-2h: it compiles OpenCV from source):
#     sudo docker build -f Dockerfile.jetson -t faceid:jetson-tx2 .
#   Run: use docker-compose.jetson.yml (mounts /data + the camera, --runtime nvidia).

ARG BASE_IMAGE=dustynv/onnxruntime:r32.7.1
FROM ${BASE_IMAGE}

# C.UTF-8 locale: avoids the UnicodeDecodeError some L4T images hit reading files under the
# default POSIX/ascii locale.
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    LANG=C.UTF-8 LC_ALL=C.UTF-8

# FFMPEG (RTSP) + OpenCV runtime libs + curl (healthcheck). build-essential/python3-dev for the
# few pip extensions that compile on ARM (InsightFace/Cython, cryptography cffi). docker.io = the
# docker CLI only (daemon unused) so the UI "Spegni" can `docker stop` over the mounted host socket
# (run.sh: -v /var/run/docker.sock:/var/run/docker.sock). "Riavvia" needs no socket (clean exit).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 curl python3-pip build-essential python3-dev docker.io \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------------------------
# OpenCV from source WITH FFMPEG + GStreamer (the base cv2 4.12 has neither -> RTSP is dead).
# We rebuild opencv-python 4.5.5.64 (last release with cp36 support) through its own
# scikit-build/cmake pipeline, forcing the backends ON via CMAKE_ARGS. Decode is software
# (NVDEC/nvv4l2decoder is NOT in this container's gstreamer plugin set, so hardware decode is out
# of scope). A separate verify step below FAILS the build if either backend is missing, so a
# broken image never ships.
#   - ENABLE_HEADLESS=1: no GUI/highgui (this runs as a web server; avoids GTK build deps).
#   - WITH_CUDA=OFF: inference uses onnxruntime-gpu, not cv2.cuda; CUDA in cv2 would only add hours.
#   - MAKEFLAGS=-j4: cap parallelism so the 8 GB TX2 doesn't OOM mid-compile.
ENV ENABLE_CONTRIB=0 ENABLE_HEADLESS=1 MAKEFLAGS=-j4 \
    CMAKE_ARGS="-DWITH_FFMPEG=ON -DWITH_GSTREAMER=ON -DWITH_V4L=ON -DWITH_LIBV4L=ON -DWITH_CUDA=OFF -DBUILD_opencv_python3=ON -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_DOCS=OFF -DOPENCV_GENERATE_PKGCONFIG=ON"

# Build + runtime deps. The gstreamer1.0-plugins-* / gstreamer1.0-libav and the ffmpeg libs are
# also needed at RUNTIME to actually decode, so we keep them (don't purge).
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake pkg-config \
        libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libavresample-dev \
        libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
        gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav gstreamer1.0-tools \
        libv4l-dev libxvidcore-dev libx264-dev libjpeg-dev libpng-dev libtiff-dev \
 && rm -rf /var/lib/apt/lists/*

# Drop the base cv2 (4.12, no backends), then compile our backend-enabled build over it.
RUN python3 -m pip install --upgrade pip setuptools wheel "scikit-build==0.13.1" \
 && rm -rf /usr/local/lib/python3.6/dist-packages/cv2 \
           /usr/local/lib/python3.6/dist-packages/opencv* \
 && python3 -m pip install --no-cache-dir --force-reinstall --no-binary opencv-python "opencv-python==4.5.5.64"

# Hard gate: abort the build unless BOTH backends are actually compiled in.
RUN python3 -c "import cv2,sys; bi=cv2.getBuildInformation(); ff=[l for l in bi.splitlines() if l.strip().startswith('FFMPEG:')][0]; gs=[l for l in bi.splitlines() if l.strip().startswith('GStreamer:')][0]; print('OpenCV',cv2.__version__,'|',ff.strip(),'|',gs.strip()); sys.exit(0 if ('YES' in ff and 'YES' in gs) else 1)"
# ---------------------------------------------------------------------------------------------

WORKDIR /app

# insightface 0.7.3 pulls opencv-python-headless>=4.1.1 transitively. No cp36 aarch64 wheel exists,
# so pip would compile it from source (~70 min) AND clobber our backend-enabled cv2 with a
# backend-less build. cv2 already comes from the opencv-python build above, so register a stub
# dist-info marking the requirement satisfied -> pip skips the redundant build.
RUN python3 -c "import os; d='/usr/local/lib/python3.6/dist-packages/opencv_python_headless-4.5.5.64.dist-info'; os.makedirs(d, exist_ok=True); open(d+'/METADATA','w').write('Metadata-Version: 2.1\nName: opencv-python-headless\nVersion: 4.5.5.64\n'); open(d+'/RECORD','w').close(); open(d+'/top_level.txt','w').write('cv2\n')"

# Install ONLY the deps not already in the base. Exclude onnxruntime / opencv-python / numpy /
# psycopg2 (provided by the base, or unused with SQLite). requirements-jetson.txt already omits
# them; the grep is a defensive double-check.
COPY requirements-jetson.txt .
RUN python3 -m pip install --upgrade pip && \
    grep -vE '^(onnxruntime|opencv-python|numpy|psycopg2)' requirements-jetson.txt > /tmp/req.txt && \
    python3 -m pip install -r /tmp/req.txt

# protobuf backend: the C++ extension (pyext/_message) makes onnx.load_model ~100x faster, but
# protobuf 3.19.6 ships it only for py>=3.7 aarch64 wheels, NOT cp36 — so on this py3.6 base the
# load stays pure-Python (~9 min, hidden by the background warm-up). Do NOT force
# PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=cpp: with no _message it crashes (ImportError). With the
# var UNSET, protobuf auto-picks cpp when the extension exists, so a future py3.8+ base is fast
# for free. The reinstall just pins the wheel (pulls the cpp build on py>=3.7).
RUN python3 -m pip install --no-cache-dir --force-reinstall --only-binary=:all: "protobuf==3.19.6" || true

COPY . .

# Everything on /data (external disk): DB, models, TensorRT engines, validation. Nothing on eMMC.
ENV DATA_DIR=/data \
    DATABASE_URL=sqlite:////data/face_id.db \
    INSIGHTFACE_HOME=/data/models \
    TRT_ENGINE_CACHE_DIR=/data/engines \
    USE_GPU=true \
    PERFORMANCE_PROFILE=standard \
    LOG_LEVEL=INFO
# InsightFace looks under ~/.insightface (base user is root): point it at the external disk.
RUN mkdir -p /data && ln -sf /data/models /root/.insightface

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

CMD ["python3", "main.py", "--web", "--host", "0.0.0.0"]
