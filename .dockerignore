# Version control / IDE
.git
.gitignore
.idea
.vscode
*.swp

# Python caches & envs
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Secrets & local config (set via compose env / -e instead)
.env
*.env

# Runtime artifacts (mounted as the /data volume, never baked into the image)
data/
*.db
*.sqlite3
*.log

# User-uploaded floor plans (may depict real environments)
web/static/maps/

# Docs not needed at runtime (keep the image small)
docs/
*.md

# Build/compose files (not needed inside the image)
Dockerfile*
docker-compose*.yml
.dockerignore

# OS
.DS_Store
